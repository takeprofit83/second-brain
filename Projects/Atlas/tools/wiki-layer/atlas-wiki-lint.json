    {
      "parameters": {
        "jsCode": "const listResp = $('List Knowledge Files').item.json;\nconst files = (listResp.body || []);\nconst filenames = files\n  .filter(f => f.type === 'file' && f.name.endsWith('.md') && !['index.md','log.md','lint-report.md'].includes(f.name))\n  .map(f => f.name);\n\nconst indexResp = $('Get Index').item.json;\nconst decodedIndex = (indexResp.statusCode === 200 && indexResp.body && indexResp.body.content)\n  ? Buffer.from(indexResp.body.content, 'base64').toString('utf-8')\n  : \"\";\n\nconst missingFromIndex = filenames.filter(name => !decodedIndex.includes(name));\nconst mentioned = [...decodedIndex.matchAll(/([a-z0-9-]+\\.md)/gi)].map(m => m[1]);\nconst danglingInIndex = [...new Set(mentioned)].filter(name => !['index.md','log.md'].includes(name) && !filenames.includes(name));\n\nconst now = new Date().toISOString().replace('T',' ').substring(0,19);\nconst summaryLine = `${now} | lint | fixed:${missingFromIndex.length} reported:${danglingInIndex.length}`;\n\nreturn [{ json: { missing_from_index: missingFromIndex, dangling_in_index: danglingInIndex, decoded_index: decodedIndex, summary_line: summaryLine } }];"
      },
      "id": "31fe5734-9d9f-c8a4-7a16-c984c6e8664f",
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-940, 0]
    },
    {
      "parameters": {
        "conditions": {
