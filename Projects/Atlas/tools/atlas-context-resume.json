      "id": "28b1aef7-05bd-40a8-8877-e9dc3ea3f83b",
      "name": "List Logs in GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        480
      ],
      "credentials": {
        "githubApi": {
          "id": "weiRggkEa4tOfXAN",
          "name": "atlas github token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst projectInfo = $('Resolve Project Path').first().json;\n\nlet latestLogName = '\\u041d\\u0435\\u0442 \\u0430\\u0440\\u0445\\u0438\\u0432\\u043d\\u044b\\u0445 \\u043b\\u043e\\u0433\\u043e\\u0432';\nif (resp.statusCode === 200 && Array.isArray(resp.body)) {\n  const logs = resp.body.filter(f => \n    f.type === 'file' && \n    f.name.endsWith('.md') && \n    !f.name.endsWith('-raw.md') && \n    !f.name.startsWith('.') &&\n    f.name !== 'project_state.md'\n  );\n  logs.sort((a, b) => b.name.localeCompare(a.name));\n  if (logs.length > 0) {\n    latestLogName = logs[0].name;\n  }\n}\n\nreturn [{\n  json: {\n    found: true,\n    latestFile: {\n      name: 'project_state.md',\n      path: projectInfo.statePath\n    },\n    latestLogName: latestLogName,\n    projectInfo: projectInfo\n  }\n}];"
      },
      "id": "2b969ab7-0959-4364-ac52-d382a98cfa4c",
      "name": "Pick Latest Conspect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        480
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/takeprofit83/second-brain/contents/{{ $json.latestFile.path }}",
        "authentication": "predefinedCredentialType",
