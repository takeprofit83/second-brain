      "id": "7f6bc556-f520-1b04-5996-22e817ba8521",
      "name": "Get Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1160, 0],
      "credentials": {
        "githubApi": { "id": "REPLACE_ME", "name": "REPLACE WITH YOUR EXISTING GITHUB CREDENTIAL" }
