    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst decoded = (resp.statusCode === 200 && resp.body && resp.body.content)\n  ? Buffer.from(resp.body.content, 'base64').toString('utf-8')\n  : \"\";\nreturn [{ json: { decoded_index: decoded } }];"
      },
      "id": "1f588f79-c519-f6ec-8723-b97ff93175b4",
