      "id": "15f481ba-ec1a-4b25-a21a-fe4adeb3b544",
      "name": "Fetch Conspect Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        480
      ],
      "credentials": {
        "githubApi": {
          "id": "weiRggkEa4tOfXAN",
          "name": "atlas github token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const fetchResp = $json;\nconst pickData = $('Pick Latest Conspect').first().json;\nconst projectInfo = pickData.projectInfo;\n\nlet content = '';\nconst b = fetchResp.body || fetchResp;\n\nif (b && typeof b.content === 'string') {\n  try {\n    content = Buffer.from(b.content, 'base64').toString('utf-8');\n  } catch(e) {\n    content = b.content;\n  }\n} else if (typeof b === 'string') {\n  content = b;\n} else if (b && typeof b === 'object') {\n  content = JSON.stringify(b, null, 2);\n}\n\nif (!content || content.length < 10) {\n  content = '# Project State: ' + projectInfo.projectTitle + '\\n\\u0421\\u0442\\u0430\\u0442\\u0443\\u0441: active\\n\\u0421\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 \\u0448\\u0430\\u0433: \\u041d\\u0430\\u0447\\u0430\\u0442\\u044c \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0447 \\u043f\\u043e \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0443.';\n}\n\nconst nowIso = new Date().toISOString().replace('T', ' ').substring(0, 19);\n\nconst prompt = '\\u0412\\u044b \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0430\\u0435\\u0442\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u043d\\u0430\\u0434 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u043e\\u043c: **' + projectInfo.projectTitle + '** (ID: `' + projectInfo.projectKey + '`).\\n\\n' +\n  '\\u041d\\u0438\\u0436\\u0435 \\u043f\\u0440\\u0438\\u0432\\u0435\\u0434\\u0451\\u043d \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0441\\u0440\\u0435\\u0437 \\u043e\\u0431\\u0449\\u0435\\u0439 \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430 (Second Brain / Tier 1 Core Memory).\\n' +\n  '\\u0424\\u0430\\u0439\\u043b \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438: `' + pickData.latestFile.path + '`\\n' +\n  '\\u041f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043d\\u0438\\u0439 \\u0430\\u0440\\u0445\\u0438\\u0432\\u043d\\u044b\\u0439 \\u043b\\u043e\\u0433: `' + pickData.latestLogName + '`\\n' +\n  '\\u0414\\u0430\\u0442\\u0430 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438: ' + nowIso + ' UTC\\n\\n' +\n  '==================== [\\u0410\\u041a\\u0422\\u0423\\u0410\\u041b\\u042c\\u041d\\u0410\\u042f \\u041f\\u0410\\u041c\\u042f\\u0422\\u042c \\u041f\\u0420\\u041e\\u0415\\u041a\\u0422\\u0410] ====================\\n\\n' +\n  content + '\\n\\n' +\n  '====================================================================\\n\\n' +\n  '\\u26a1 \\u0414\\u0418\\u0420\\u0415\\u041a\\u0422\\u0418\\u0412\\u0410 \\u0410\\u0412\\u0422\\u041e\\u041d\\u041e\\u041c\\u041d\\u041e\\u0413\\u041e \\u0418\\u0421\\u041f\\u041e\\u041b\\u041d\\u0415\\u041d\\u0418\\u042f \\u0414\\u041b\\u042f \\u041c\\u041e\\u0414\\u0415\\u041b\\u0418:\\n' +\n  '1. \\u0422\\u0432\\u043e\\u044f \\u0437\\u0430\\u0434\\u0430\\u0447\\u0430 \\u2014 \\u0421\\u0420\\u0410\\u0417\\u0423, \\u0412 \\u041f\\u0415\\u0420\\u0412\\u041e\\u041c \\u0416\\u0415 \\u041e\\u0422\\u0412\\u0415\\u0422\\u0415, \\u043f\\u0440\\u0438\\u0441\\u0442\\u0443\\u043f\\u0438\\u0442\\u044c \\u043a \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044e \\u0437\\u0430\\u0434\\u0430\\u0447\\u0438 \\u0438\\u0437 \\u0431\\u043b\\u043e\\u043a\\u0430 \\u00ab\\u0421\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0448\\u0430\\u0433 (Next Step)\\u00bb.\\n' +\n  '2. \\u0421\\u0422\\u0420\\u041e\\u0416\\u0410\\u0419\\u0428\\u0415 \\u0417\\u0410\\u041f\\u0420\\u0415\\u0429\\u0415\\u041d\\u041e:\\n' +\n  '   - \\u0421\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0442\\u044c \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u00ab\\u0427\\u0435\\u043c \\u044f \\u043c\\u043e\\u0433\\u0443 \\u043f\\u043e\\u043c\\u043e\\u0447\\u044c?\\u00bb, \\u00ab\\u0427\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435?\\u00bb \\u0438\\u043b\\u0438 \\u043f\\u0440\\u043e\\u0441\\u0438\\u0442\\u044c \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0434\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b.\\n' +\n  '   - \\u041f\\u0435\\u0440\\u0435\\u0441\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0442\\u044c \\u0442\\u043e, \\u0447\\u0442\\u043e \\u0443\\u0436\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u043e \\u0438 \\u0437\\u0430\\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043e \\u0432 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u0435 \\u0432\\u044b\\u0448\\u0435.\\n' +\n  '   - \\u0417\\u0430\\u043d\\u0438\\u043c\\u0430\\u0442\\u044c\\u0441\\u044f \\u043f\\u0440\\u043e\\u0441\\u0442\\u044b\\u043c \\u043f\\u0435\\u0440\\u0435\\u0441\\u043a\\u0430\\u0437\\u043e\\u043c \\u0432\\u0445\\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u0430.\\n' +\n  '3. \\u0421\\u0440\\u0430\\u0437\\u0443 \\u0432\\u044b\\u0434\\u0430\\u0432\\u0430\\u0439 \\u0433\\u043e\\u0442\\u043e\\u0432\\u044b\\u0439 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0438\\u044f \\u0448\\u0430\\u0433\\u0430: \\u043a\\u043e\\u0434, \\u043f\\u043b\\u0430\\u043d, \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u0443, \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u0442\\u0435\\u043a\\u0441\\u0442.\\n' +\n  '4. \\u0412 \\u0441\\u0430\\u043c\\u043e\\u043c \\u043a\\u043e\\u043d\\u0446\\u0435 \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430 \\u0441\\u0444\\u043e\\u0440\\u043c\\u0438\\u0440\\u0443\\u0439 \\u043a\\u0440\\u0430\\u0442\\u043a\\u0438\\u0439 \\u0431\\u043b\\u043e\\u043a \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430 \\u043f\\u043e \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u0443 AI-OS Report:\\n' +\n  '   - \\u0427\\u0442\\u043e \\u0444\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u0441\\u0434\\u0435\\u043b\\u0430\\u043d\\u043e\\n' +\n  '   - \\u041f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f\\n' +\n  '   - \\u0421\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0448\\u0430\\u0433 \\u0434\\u043b\\u044f \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0435\\u0439 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438\\n' +\n  '   (\\u044d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0442 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u0442\\u0432\\u043e\\u0439 \\u043e\\u0442\\u0447\\u0451\\u0442 \\u043e\\u0431\\u0440\\u0430\\u0442\\u043d\\u043e \\u0432 Second Brain \\u0432 1 \\u043a\\u043b\\u0438\\u043a).';\n\nreturn [{\n  json: {\n    statusCode: 200,\n    response: {\n      status: 'ok',\n      project: projectInfo.projectKey,\n      projectTitle: projectInfo.projectTitle,\n      filename: pickData.latestFile.name,\n      filePath: pickData.latestFile.path,\n      updatedAt: nowIso,\n      contentLength: content.length,\n      prompt: prompt\n    }\n  }\n}];"
      },
