      "typeVersion": 4.2,
      "position": [-500, -220],
      "credentials": {
        "githubApi": { "id": "REPLACE_ME", "name": "REPLACE WITH YOUR EXISTING GITHUB CREDENTIAL" }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $('Get Index Fresh2').item.json;\nconst decoded = (resp.statusCode === 200 && resp.body && resp.body.content)\n  ? Buffer.from(resp.body.content, 'base64').toString('utf-8')\n  : $('Compare').item.json.decoded_index;\nconst missing = $('Compare').item.json.missing_from_index;\nlet updated = decoded;\nfor (const name of missing) {\n  if (!updated.includes(name)) {\n    updated = updated.trimEnd() + `\\n- [[${name.replace(/\\.md$/,'')}]] (auto-added by lint, no description yet)\\n`;\n  }\n}\nreturn [{ json: { new_index_content: updated } }];"
      },
