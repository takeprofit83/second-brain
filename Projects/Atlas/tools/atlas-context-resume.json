    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst project = (body.project || 'atlas').toLowerCase().trim();\n\nconst mapping = {\n  'atlas': { \n    statePath: 'Projects/Atlas/project_state.md', \n    logsPath: 'Projects/Atlas/logs', \n    title: 'Atlas (AI-OS & Automation Engine)' \n  },\n  'courses': { \n    statePath: 'Courses/project_state.md', \n    logsPath: 'Courses', \n    title: '\\u041a\\u0443\\u0440\\u0441\\u044b \\u0438 \\u041e\\u0431\\u0443\\u0447\\u0435\\u043d\\u0438\\u0435 (Courses)' \n  },\n  'dzen': { \n    statePath: 'Projects/Dzen/project_state.md', \n    logsPath: 'Projects/Dzen/logs', \n    title: '\\u042f\\u043d\\u0434\\u0435\\u043a\\u0441 \\u0414\\u0437\\u0435\\u043d (Dzen)' \n  },\n  'nastya': { \n    statePath: 'Projects/Nastya/project_state.md', \n    logsPath: 'Projects/Nastya/logs', \n    title: '\\u041f\\u0440\\u043e\\u0435\\u043a\\u0442 \\u041d\\u0430\\u0441\\u0442\\u044f (Nastya)' \n  },\n  'dacha': { \n    statePath: 'Projects/Dacha/project_state.md', \n    logsPath: 'Projects/Dacha/logs', \n    title: '\\u0423\\u043c\\u043d\\u0430\\u044f \\u0414\\u0430\\u0447\\u0430 (Dacha)' \n  },\n  'other': { \n    statePath: 'Projects/Other/project_state.md', \n    logsPath: 'Projects/Other/logs', \n    title: '\\u0414\\u0440\\u0443\\u0433\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b (Other Sandbox)' \n  }\n};\n\nconst target = mapping[project] || mapping['atlas'];\nreturn [{\n  json: {\n    projectKey: project,\n    projectTitle: target.title,\n    statePath: target.statePath,\n    logsPath: target.logsPath,\n    repoPath: target.logsPath\n  }\n}];"
      },
      "id": "a9cef575-e6b1-4fda-a260-f259c2e9df2b",
      "name": "Resolve Project Path",
