      "position": [-960, 0]
    },
    {
      "parameters": {
        "jsCode": "const decodedIndex = $json.decoded_index;\nconst body = ($('Webhook').item.json.body) || {};\nconst newConspect = body.content || \"\";\nreturn [{ json: { combined_input: JSON.stringify({ current_index: decodedIndex, new_conspect: newConspect }) } }];"
      },
      "id": "0692ff59-d6a9-aac5-2a2c-29c90a8f3843",
      "name": "Build LLM Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 0]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $('Webhook').item.json.body.provider === 'OpenRouter' ? 'FCHKR5wwDT1ZYdKu' : 'gu85dO6jBAoB1S9r' }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "user_input": "={{ $json.combined_input }}",
            "system_prompt": "Given the current wiki index and one new conspect, decide ONE topic page to create or update (not several). Output STRICT JSON only, no markdown code fences, no extra text: {\"page_path\": \"Knowledge/<slug>.md\", \"page_title\": \"...\", \"page_content\": \"<full markdown page, use [[wikilink]] syntax for references to other Knowledge/ pages>\", \"index_line\": \"<one markdown list line for index.md>\"}. <slug> must be lowercase-kebab-case, ASCII only (transliterate Russian if needed). If the conspect doesn't warrant a new page, still pick the closest existing page from the index and update it rather than skipping - always return exactly one page.",
            "model": "anthropic/claude-sonnet-5"
          }
        }
      },
      "id": "6f6e28a2-f225-7cb1-08d7-28a863ed9f21",
      "name": "Call Wiki Ingest LLM",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-520, 0]
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.answer || \"\";\nraw = raw.trim();\nif (raw.startsWith(\"```\")) {\n  raw = raw.replace(/^```(json)?\\n?/, \"\").replace(/```\\s*$/, \"\");\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error(\"Wiki Ingest LLM did not return valid JSON: \" + e.message + \" | raw: \" + raw.slice(0, 300));\n}\nif (!parsed.page_path || !parsed.page_content || !parsed.index_line) {\n  throw new Error(\"Wiki Ingest LLM JSON missing required fields: \" + JSON.stringify(parsed));\n}\nreturn [{ json: parsed }];"
      },
      "id": "a83e622d-19d6-ad1d-6e06-c53e6cb47c0b",
      "name": "Parse LLM JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/takeprofit83/second-brain/contents/{{ $json.page_path }}",
