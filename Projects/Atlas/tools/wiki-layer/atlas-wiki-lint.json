    {
      "parameters": {
        "jsCode": "const resp = $('Get Report Fresh').item.json;\nconst existed = resp.statusCode === 200;\nconst dangling = $('Compare').item.json.dangling_in_index;\nconst now = new Date().toISOString().replace('T',' ').substring(0,19);\nconst body = `# Wiki Lint Report\\n\\nLast run: ${now}\\n\\n## Dangling references (in index.md, no matching file in Knowledge/)\\n\\n` +\n  (dangling.length ? dangling.map(n => `- ${n}`).join('\\n') : '_none_') + '\\n';\nreturn [{ json: { report_content: body, report_existed: existed } }];"
      },
